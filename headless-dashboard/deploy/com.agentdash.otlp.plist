<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: OTLP/HTTP JSON receiver on 127.0.0.1:4318, restarted if it exits. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentdash.otlp</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>exec __HOME__/.local/bin/orch-dashboard --otlp</string></array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>__HOME__/.claude/agent-dashboard/otlp.err</string>
</dict>
</plist>
