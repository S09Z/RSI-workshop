{
 "case_id": "g8-bash-via-symlinked-done-when",
 "guardrail": "G8",
 "hook": "g8_worker_tests.py",
 "expect": "block",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "session_id": "s1",
  "cwd": "{TMP}",
  "agent_id": "a1",
  "agent_type": "worker",
  "tool_name": "Bash",
  "tool_input": {
   "command": "sed -i '' s/a/b/ tests/test_l.py"
  }
 },
 "files": {
  "shared/t.py": "x",
  "tests/test_x.py": "x"
 },
 "symlinks": {
  "tests/test_l.py": "shared/t.py"
 },
 "pre": [
  {
   "hook": "g8_capture.py",
   "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s1",
    "cwd": "{TMP}",
    "agent_type": "orchestrator",
    "tool_name": "Agent",
    "tool_input": {
     "subagent_type": "worker",
     "description": "d",
     "prompt": "DONE_WHEN_FILES: tests/test_l.py\n"
    }
   }
  }
 ]
}