{
 "case_id": "ctl-g7-git-commit-heredoc",
 "guardrail": "G7",
 "hook": "g7_worker_gitroot.py",
 "expect": "allow",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "session_id": "s1",
  "cwd": "{TMP}",
  "tool_name": "Bash",
  "tool_input": {
   "command": "git commit -m \"$(cat <<'EOF'\nfix: it's done\n\nCo-Authored-By: X <a@b.c>\nEOF\n)\""
  },
  "agent_id": "a1",
  "agent_type": "worker"
 },
 "files": {
  ".git/HEAD": "ref: refs/heads/main\n",
  "src/app.py": "x = 1\n"
 }
}
