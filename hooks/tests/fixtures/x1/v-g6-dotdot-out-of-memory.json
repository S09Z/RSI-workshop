{
 "case_id": "g6-dotdot-out-of-memory",
 "guardrail": "G6",
 "hook": "g6_advisor_memory.py",
 "expect": "block",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "session_id": "s1",
  "cwd": "{TMP}",
  "tool_name": "Write",
  "tool_input": {
   "file_path": "{TMP}/mem/../x.md",
   "content": "x"
  },
  "agent_id": "a1",
  "agent_type": "advisor"
 },
 "files": {
  "mem/MEMORY.md": "x\n",
  "src/app.py": "x = 1\n",
  "outside/keep": ""
 },
 "env": {
  "AGENT_ADVISOR_MEMORY_DIR": "{TMP}/mem"
 }
}
