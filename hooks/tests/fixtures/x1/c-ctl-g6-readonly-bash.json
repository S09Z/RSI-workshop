{
 "case_id": "ctl-g6-readonly-bash",
 "guardrail": "G6",
 "hook": "g6_advisor_memory.py",
 "expect": "allow",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "session_id": "s1",
  "cwd": "{TMP}",
  "tool_name": "Bash",
  "tool_input": {
   "command": "cat mem/MEMORY.md && git log -n 1"
  },
  "agent_id": "a1",
  "agent_type": "advisor"
 },
 "files": {
  "mem/MEMORY.md": "x\n",
  "src/app.py": "x = 1\n",
  "outside/keep": ""
 },
 "env": {
  "AGENT_ADVISOR_MEMORY_DIR": "{TMP}/mem"
 }
}
