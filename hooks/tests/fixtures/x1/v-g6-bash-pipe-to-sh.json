{
 "case_id": "g6-bash-pipe-to-sh",
 "guardrail": "G6",
 "hook": "g6_advisor_memory.py",
 "expect": "block",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "session_id": "s1",
  "cwd": "{TMP}",
  "tool_name": "Bash",
  "tool_input": {
   "command": "echo 'touch {TMP}/src/f' | sh"
  },
  "agent_id": "a1",
  "agent_type": "advisor"
 },
 "files": {
  "mem/MEMORY.md": "x\n",
  "src/app.py": "x = 1\n"
 },
 "env": {
  "AGENT_ADVISOR_MEMORY_DIR": "{TMP}/mem"
 }
}
