{
 "case_id": "g8-non-test-like-done-when",
 "guardrail": "G8",
 "hook": "g8_worker_tests.py",
 "expect": "block",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "session_id": "s1",
  "cwd": "{TMP}",
  "agent_id": "a1",
  "agent_type": "worker",
  "tool_name": "Edit",
  "tool_input": {
   "file_path": "{TMP}/verify/acceptance.sh",
   "old_string": "a",
   "new_string": "b"
  }
 },
 "files": {
  "verify/acceptance.sh": "true"
 },
 "pre": [
  {
   "hook": "g8_capture.py",
   "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s1",
    "cwd": "{TMP}",
    "agent_type": "orchestrator",
    "tool_name": "Agent",
    "tool_input": {
     "subagent_type": "worker",
     "description": "d",
     "prompt": "DONE_WHEN: `bash verify/acceptance.sh`\nDONE_WHEN_FILES: verify/acceptance.sh\n"
    }
   }
  }
 ]
}