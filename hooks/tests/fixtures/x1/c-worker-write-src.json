{
 "case_id": "ctl-worker-write-src",
 "guardrail": "G8",
 "hook": "g8_worker_tests.py",
 "expect": "allow",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "session_id": "s1",
  "cwd": "{TMP}",
  "agent_id": "a1",
  "agent_type": "worker",
  "tool_name": "Write",
  "tool_input": {
   "file_path": "{TMP}/src/app.py",
   "content": "x = 2\n"
  }
 },
 "files": {
  "tests/test_x.py": "def test_a():\n    assert True\n",
  "src/app.py": "x = 1\n"
 },
 "pre": [
  {
   "hook": "g8_capture.py",
   "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s1",
    "cwd": "{TMP}",
    "agent_type": "orchestrator",
    "tool_name": "Agent",
    "tool_input": {
     "subagent_type": "worker",
     "description": "d",
     "prompt": "[T1] fix\nDONE_WHEN: `pytest tests/test_x.py` passes\nDONE_WHEN_FILES: tests/test_x.py\n"
    }
   }
  }
 ]
}