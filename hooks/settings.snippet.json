{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write|Edit|NotebookEdit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 -I \"$HOME/.claude/hooks/g2_orchestrator_nowrite.py\"" },
          { "type": "command", "command": "python3 -I \"$HOME/.claude/hooks/g8_worker_tests.py\"" }
        ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "python3 -I \"$HOME/.claude/hooks/g8_worker_tests.py\"" } ] },
      { "matcher": "Agent",
        "hooks": [ { "type": "command", "command": "python3 -I \"$HOME/.claude/hooks/g8_capture.py\"" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"$HOME/.claude/hooks/g1_report_contract.py\"" } ] }
    ]
  }
}
